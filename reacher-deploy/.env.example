# Copy to .env on the VPS and fill in. Never commit the real .env.
# Public access is via your Cloudflare Tunnel hostname (set that in the CF dashboard,
# routing it to http://localhost:8080) — no domain/port config needed here.

# Shared secret — must match REACHER_SECRET in the Vercel app env.
RCH__HEADER_SECRET=replace-me

# PrivadoVPN SOCKS5 proxy.
RCH__PROXY__HOST=bom.socks.privado.io
RCH__PROXY__PORT=1080
RCH__PROXY__USERNAME=your-proxy-username
RCH__PROXY__PASSWORD=your-proxy-password

# SMTP identity sent during probing. Neutral, generic values (reacher's defaults) —
# keeps your own domain out of the conversation.
RCH__FROM_EMAIL=verify@gmail.com
RCH__HELLO_NAME=gmail.com
