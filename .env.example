MILLIONVERIFIER_API_KEY=your-api-key

# Upstash Redis — stores each domain's learned email format so the optimization
# is shared org-wide and survives restarts. Optional: if unset, learning falls
# back to per-instance in-memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase — auth + per-user verification history + admin dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS; used by the admin dashboard. Never expose to the client.
SUPABASE_SECRET_KEY=
# Comma-separated emails allowed to view /admin.
ADMIN_EMAILS=ops@researchnxt.com

